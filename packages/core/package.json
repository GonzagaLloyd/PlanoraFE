{
  "name": "@planora/widget",
  "version": "0.1.0",
  "description": "Planora widget core: capture, report and track bugs and feature requests from any website.",
  "keywords": [
    "planora",
    "widget",
    "bug-report",
    "feedback",
    "feature-request",
    "screenshot"
  ],
  "license": "MIT",
  "homepage": "https://github.com/GonzagaLloyd/PlanoraFE/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GonzagaLloyd/PlanoraFE.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/GonzagaLloyd/PlanoraFE/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/widget.js"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch --mode development"
  },
  "dependencies": {
    "@planora/widget-contract": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "preact": "^10.29.8",
    "modern-screenshot": "^4.7.0"
  }
}
